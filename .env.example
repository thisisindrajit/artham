# Server-only URL used by Next.js to load generated stories and proxy media.
ARTHAM_BACKEND_BASE_URL=http://127.0.0.1:8090

# Optional live learning-partner service. Deterministic fallbacks are used when absent.
PARTNER_URL=http://127.0.0.1:8080

# Better Auth and Google OAuth.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artham
AUTH_DATABASE_SSL=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Development only. Never enable this in production.
ARTHAM_BYPASS_AUTH=false
