ARTHAM_ENVIRONMENT=local
ARTHAM_DEBUG=false
ARTHAM_CORS_ORIGINS=["http://localhost:3000"]
ARTHAM_DATABASE_URL=postgresql+asyncpg://artham:change-me@localhost:5432/artham
ARTHAM_DATABASE_SSL=true
ARTHAM_INTERNAL_API_KEY=replace-with-a-strong-service-token
ARTHAM_MAX_REQUEST_BYTES=10485760
ARTHAM_UPLOAD_URL_TTL_SECONDS=600
ARTHAM_MAX_IMAGE_UPLOAD_BYTES=26214400
ARTHAM_MAX_VIDEO_UPLOAD_BYTES=262144000
ARTHAM_MAX_AUDIO_UPLOAD_BYTES=52428800
ARTHAM_MEDIA_SCAN_REQUIRED=false
ARTHAM_EMBEDDING_DIMENSIONS=768
ARTHAM_GCP_PROJECT=your-google-cloud-project
ARTHAM_GCS_BUCKET=artham-generated-media
ARTHAM_GCS_SIGNING_SERVICE_ACCOUNT=artham-backend@your-google-cloud-project.iam.gserviceaccount.com
ARTHAM_CDN_BASE_URL=https://storage.googleapis.com/artham-generated-media
# For local development only; prefer workload identity in deployed environments.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
