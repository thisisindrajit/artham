# Gemini Enterprise / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Story-generation pipeline
OPENAI_API_KEY=your-openai-api-key
# Required when any model below uses the openrouter/ prefix.
OPENROUTER_API_KEY=your-openrouter-api-key
EXA_API_KEY=your-exa-api-key
ARTHAM_BACKEND_BASE_URL=http://localhost:8090
ARTHAM_BACKEND_API_KEY=replace-with-a-service-token
ARTHAM_ARCHITECT_MODEL=openai/gpt-5.4
ARTHAM_CRITIC_MODEL=openai/gpt-5.4
ARTHAM_WORKER_MODEL=openai/gpt-5.4-mini
ARTHAM_TOPIC_MODEL=openai/gpt-5.4-mini
ARTHAM_SESSION_DATABASE_URL=sqlite+aiosqlite:////tmp/artham-adk-sessions.db
ARTHAM_VERTEX_MEDIA_LOCATION=us-central1
# Image and video route through OpenRouter; music and embeddings stay on Vertex.
# Drop the openrouter/ prefix to fall back to Vertex for that asset type.
ARTHAM_IMAGE_MODEL=openrouter/google/gemini-3.1-flash-lite-image
# Video generation is intentionally disabled in the story workflow.
ARTHAM_VEO_MODEL=openrouter/google/veo-3.1-fast
ARTHAM_LYRIA_MODEL=lyria-3-clip-preview
ARTHAM_EMBEDDING_MODEL=gemini-embedding-001

# Optional
ARTHAM_LOG_LEVEL=INFO
ARTHAM_ALLOWED_ORIGINS=http://localhost:3000
ARTHAM_PROVIDER_TIMEOUT_SECONDS=30
ARTHAM_MEDIA_TIMEOUT_SECONDS=900
ARTHAM_MAX_MEDIA_CONCURRENCY=4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
