# Gemini Enterprise / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Story-generation pipeline
EXA_API_KEY=your-exa-api-key
ARTHAM_BACKEND_BASE_URL=http://localhost:8090
ARTHAM_BACKEND_API_KEY=replace-with-a-service-token
ARTHAM_PIPELINE_MODEL=gemini-3.7-flash
ARTHAM_FAST_MODEL=gemini-3.7-flash
ARTHAM_VERTEX_MEDIA_LOCATION=us-central1
ARTHAM_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Video generation is intentionally disabled in the story workflow.
ARTHAM_VEO_MODEL=veo-3.1-generate-001
ARTHAM_LYRIA_MODEL=lyria-3-clip-preview
ARTHAM_EMBEDDING_MODEL=gemini-embedding-001

# Optional
ARTHAM_LOG_LEVEL=INFO
ARTHAM_ALLOWED_ORIGINS=http://localhost:3000
ARTHAM_PROVIDER_TIMEOUT_SECONDS=30
ARTHAM_MEDIA_TIMEOUT_SECONDS=900
ARTHAM_MAX_MEDIA_CONCURRENCY=4
